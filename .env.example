# --- Runtime ---
ESCRIBA_ENVIRONMENT=development          # development | staging | production
ESCRIBA_LOG_LEVEL=INFO
ESCRIBA_DEMO_MODE=false                  # expose legacy API routes in development

# --- Visit capture and note generation ---
ESCRIBA_OPENAI_API_KEY=
ESCRIBA_TRANSCRIPTION_MODEL=gpt-4o-transcribe-diarize
SPANISH_VISITS_NOTE_LANGUAGE=es

# --- Database ---
# Local:      sqlite+aiosqlite:///./escriba.db
# Production: postgresql+asyncpg://user:password@host:5432/escriba
ESCRIBA_DATABASE_URL=sqlite+aiosqlite:///./escriba.db
ESCRIBA_DATABASE_ECHO=false
ESCRIBA_AUTO_CREATE_SCHEMA=true          # dev only; production uses migrations

# --- Twilio ---
ESCRIBA_TWILIO_AUTH_TOKEN=
ESCRIBA_TWILIO_VALIDATE_SIGNATURE=true
# Public URL Twilio calls (needed behind ngrok / load balancers for signature checks)
ESCRIBA_PUBLIC_BASE_URL=

# --- Phase 1 sandbox routing ---
ESCRIBA_DEFAULT_PROVIDER_ID=provider-sandbox-001
